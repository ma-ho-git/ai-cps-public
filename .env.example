# AI-CPS deployment defaults for linux/amd64 under WSL2/Ubuntu or native Linux.
# Copy this file to .env and change only site-specific values. Never commit .env.

# Stabiler Compose-Namensraum und Host-Benutzer fuer persistente Laufzeitdaten.
# Der Setup-Assistent setzt UID/GID automatisch fuer den aktuellen Benutzer.
COMPOSE_PROJECT_NAME=ai-cps-nn-runtime
AI_CPS_UID=1000
AI_CPS_GID=1000

# Physical broker. The virtual stack overrides this with its Mosquitto service.
MQTT_HOST=192.168.0.5
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Host paths may be absolute or relative to the scenario Compose directory.
REPORT_ROOT_HOST=../../../reports
NODE_RED_PORT=1880
NODE_RED_CREDENTIAL_SECRET=replace-with-a-long-random-site-secret
HMI_READY_TIMEOUT_S=60
# Das virtuelle FlowFuse Dashboard 2.0 ist nach `virtual-hmi` unter
# http://localhost:${NODE_RED_PORT}/dashboard/betrieb erreichbar. Es nutzt die
# folgenden Werte als Startvorgaben; im HMI gewaehlt werden koennen Modellprofil,
# Testszenario, Seed und die vier Modulbasiszeiten. Broker, beliebige lokale
# Kandidaten und Command-Modus bleiben bewusst Neustart-/CLI-Konfiguration.
# `virtual-hmi` meldet erst Erfolg, wenn `/dashboard/betrieb` innerhalb von
# HMI_READY_TIMEOUT_S per HTTP erreichbar ist.
# Der virtuelle Helper verbindet seine lokalen mosquitto_pub/sub-Aufrufe mit
# diesem Host. `virtual-run` setzt den Command-Output fuer KI-Flow, VGR und HBW
# gemeinsam auf true; `--diagnosis` setzt alle drei auf false. `physical-up`
# bleibt mit dem Wert unten im Diagnosebetrieb. Die physische Freigabe erfolgt
# bewusst mit `physical-up --command-output-enabled`.
VIRTUAL_MQTT_HOST=localhost
# Maximale Wartezeit sowohl fuer die virtuelle Orchestrierungsbereitschaft als
# auch fuer die drei physischen NN-Statusmeldungen.
READY_TIMEOUT_S=180
COMMAND_OUTPUT_ENABLED=false
FACTORY_SEED=42
# Virtuelle Basiszeiten pro Modul in Millisekunden. Fuer jeden Command wird
# die jeweilige Basiszeit reproduzierbar mit einem Faktor von 0,5 bis 1,5
# variiert. Aenderungen werden beim naechsten virtuellen Stackstart wirksam.
FACTORY_VGR_BASE_RUNTIME_MS=100
FACTORY_HBW_BASE_RUNTIME_MS=100
FACTORY_MPO_BASE_RUNTIME_MS=100
FACTORY_SLD_BASE_RUNTIME_MS=100
# Virtueller Datensatz: standard, full-storage-attempt oder
# full-storage-process-guard.
TRACE_PROFILE=standard
# Nur virtuell: deployment-current oder historical-full-storage-error.
# Das historische Profil demonstriert den frueheren Vollspeicherfehler.
MODEL_PROFILE=deployment-current

# Der Release-Schnellstart traegt digest-genaue *_IMAGE-Referenzen automatisch
# ein. Leere Werte unten behalten fuer Entwickler den lokalen Source-Build.
# Manuelle Image-Aenderungen sind nicht durch das Release-Manifest abgesichert.
# Source builds use the local image repositories below. For validated GHCR
# images, start the helper with --images and set IMAGE_TAG to a published tag.
# Virtuell werden alle vier Runtimeimages geladen, physisch nur die drei NNs.
GHCR_OWNER=ma-ho-git
IMAGE_TAG=local
STORAGE_IMAGE_REPOSITORY=ft_cb_storage
VGR_IMAGE_REPOSITORY=ft_cb_vgr
HBW_IMAGE_REPOSITORY=ft_cb_hbw
NODE_RED_IMAGE_REPOSITORY=ai-cps-node-red

# Optionale Modellauswahl. Leere Werte verwenden weiterhin den versionierten
# Deployment-Standard /model_registry/<domain>/latest. Fuer Kandidaten immer
# manage_model_candidates.py verwenden: Nur dessen Auswahl wird geprueft,
# protokolliert und kann per rollback wiederhergestellt werden. Die drei Werte
# gelten gemeinsam fuer den jeweils naechsten virtuellen oder physischen Start.
STORAGE_MODEL_DIR=
VGR_MODEL_DIR=
HBW_MODEL_DIR=

# Optionale vollstaendige Image-Referenzen fuer MQTT-kompatible Ersatzdienste
# und das virtuelle Node-RED-/Dashboard-Image.
# Benoetigte Referenzen setzen und mit --images starten. Leere Werte behalten
# die Repository- und IMAGE_TAG-Konvention oben. Der Kandidatenmanager verwaltet
# Artefaktordner, nicht diese alternativen Containerimages.
STORAGE_IMAGE=
VGR_IMAGE=
HBW_IMAGE=
NODE_RED_IMAGE=
