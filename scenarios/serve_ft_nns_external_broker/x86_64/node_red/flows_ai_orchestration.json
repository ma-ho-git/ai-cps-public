  {
    "id": "comment-ai-reporting",
    "type": "comment",
    "z": "tab-ai-orchestration",
    "g": "group-ai-reporting",
    "name": "Reporting formatiert fachliche Daten; File-Nodes uebernehmen das Schreiben.",
    "info": "Der Function-Node bildet aus einem abgeschlossenen Zyklus konsistente Inhalte fuer events.jsonl, summary.csv und run_summary.json. split-, switch- und file-Nodes uebernehmen danach die sichtbare Dateiverteilung und das Schreiben.",
