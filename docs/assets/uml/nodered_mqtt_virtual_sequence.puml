@startuml
' Editierbar unter https://editor.plantuml.com/uml/

hide footbox
title AI-CPS-Simulationssystem - Virtuelle Simulation

skinparam backgroundColor white
skinparam shadowing false
skinparam sequence {
  ArrowColor #35516e
  ArrowFontColor #203044
  ArrowFontSize 12
  LifeLineBorderColor #35516e
  LifeLineBackgroundColor white
  ParticipantBorderColor #263746
  ParticipantBackgroundColor white
  ParticipantFontColor #203044
  ParticipantFontSize 13
  ParticipantPadding 28
  BoxBorderColor #263746
  BoxFontColor #203044
  BoxFontSize 14
  GroupBorderColor #56636f
  GroupBackgroundColor white
  GroupFontColor #203044
}

box "Host"
  participant ":Startskript" as start
end box

box "Node-RED"
  participant ":Initialisierung" as init
  participant ":Zustands-Flow" as state
  participant ":Semaphor-Flow" as semaphore
  participant ":KI-Flow" as ai
  participant ":Modul-Flows" as modules
end box

box "NN-Anwendungsdienste"
  participant ":Storage-NN" as storage
  participant ":VGR-NN" as vgr
  participant ":HBW-NN" as hbw
end box

start ->> init : MQTT: Simulation starten
activate init
init ->> modules : MQTT: 4 Idle-Commands
deactivate init
activate modules
modules -> modules : sent_count++ + Delay
modules -> modules : accepted_count++
deactivate modules

loop Testszenario; nächster Zustand erst nach vier Modulabschlüssen
  state ->> semaphore : MQTT: Rohzustand [alle 50 ms]
  note right of state
    Wiederholte Samples möglich;
    Traceindex bleibt konstant
  end note
  activate semaphore
  semaphore -> semaphore : 4 Jobcounterpaare prüfen
  semaphore ->> ai : MQTT: freigegebener Anlagenzustand
  deactivate semaphore
  activate ai

  ai ->> storage : MQTT: Lagerzustand
  activate storage
  storage ->> ai : MQTT: freies Lagerfach
  deactivate storage

  ai -> ai : Merkmalsfenster bilden\n[bei neuer Quelle: 9 Idle-Seeds ergänzen]
  ai ->> modules : MQTT: MPO-/SLD-Idle

  par VGR: Inferenz + Command
    ai ->> vgr : MQTT: VGR-Fenster
    activate vgr
    vgr ->> modules : MQTT: VGR-Command
    vgr ->> ai : MQTT: VGR-Ergebnis\n[nur Report/Diagnose]
    deactivate vgr
  else HBW: Inferenz + Command
    ai ->> hbw : MQTT: HBW-Fenster
    activate hbw
    hbw ->> modules : MQTT: HBW-Command
    hbw ->> ai : MQTT: HBW-Ergebnis\n[nur Report/Diagnose]
    deactivate hbw
  end

  ai -> ai : Ergebnisse für Report zusammenführen\n[keine Command-Barriere]
  deactivate ai

  activate modules
  modules -> modules : 4 Teilprozesse unabhängig ausführen\n[Core-Delay; Standard: 0,1 s ±50 %]
  modules -> modules : accepted_count je Modul erhöhen
  deactivate modules
end

legend bottom
  |= Pfeil |= Bedeutung |
  | ->> | asynchrone Nachricht |
  | -> | synchroner Aufruf |
  | -->> | Rückgabe |
endlegend

@enduml
