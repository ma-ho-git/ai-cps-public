@startuml
' Editierbar unter https://editor.plantuml.com/uml/
' Command-Flows, Semaphor-Flow und KI-Flow sind logische Rollen
' des externen Black-Box-Systems.

hide footbox
title AI-CPS-Live-System - Physischer Live-Betrieb

skinparam backgroundColor white
skinparam shadowing false
skinparam sequence {
  ArrowColor #35516e
  ArrowFontColor #203044
  ArrowFontSize 12
  LifeLineBorderColor #35516e
  LifeLineBackgroundColor white
  ParticipantBorderColor #263746
  ParticipantBackgroundColor white
  ParticipantFontColor #203044
  ParticipantFontSize 13
  ParticipantPadding 28
  BoxBorderColor #263746
  BoxFontColor #203044
  BoxFontSize 14
  GroupBorderColor #56636f
  GroupBackgroundColor white
  GroupFontColor #203044
}

box "Physische Anlage (Black Box)"
  participant ":SPS / Module" as sps
end box

box "Node-RED (Black Box)"
  participant ":Command-Flows" as commands
  participant ":Semaphor-Flow" as semaphore
  participant ":KI-Flow" as ai
end box

box "NN-Anwendungsdienste"
  participant ":Storage-NN" as storage
  participant ":VGR-NN" as vgr
  participant ":HBW-NN" as hbw
end box

opt Systemstart
  activate semaphore
  semaphore ->> commands : MQTT: initiales Idle-Command-Set
  activate commands
  commands -> commands : sent_count je Modul erhöhen
  commands -> sps : OPC UA: Idle-Befehle aufrufen
  sps -->> commands : angenommen
  sps ->> semaphore : OPC UA: Modulabschlüsse\n[accepted_count++]
  semaphore -> semaphore : Jobcounter vergleichen
  deactivate commands
  deactivate semaphore
end

loop je synchronisiertem Anlagenzustand; nächster Zustand erst nach vier Modulabschlüssen
  activate semaphore
  semaphore ->> ai : MQTT: Anlagenzustand
  note over semaphore, ai
    Erste Zustandsmeldung beim Anlagenstart: Idle
  end note
  activate ai
  activate commands

  ai ->> storage : MQTT: Lagerzustand
  activate storage
  storage ->> ai : MQTT: freies Lagerfach
  deactivate storage

  ai -> ai : Merkmalsfenster bilden\n[bei neuer Quelle: 9 Idle-Seeds ergänzen]
  ai ->> commands : MQTT: MPO-/SLD-Idle\n[sent_count++]
  commands -> sps : OPC UA: MPO/SLD-Idle aufrufen

  par VGR: Inferenz + Command
    ai ->> vgr : MQTT: VGR-Fenster
    activate vgr
    vgr ->> commands : MQTT: VGR-Command\n[sent_count++]
    commands -> sps : OPC UA: VGR aufrufen
    sps -->> commands : angenommen
    vgr ->> ai : MQTT: VGR-Ergebnis\n[nur Report/Diagnose]
    deactivate vgr
  else HBW: Inferenz + Command
    ai ->> hbw : MQTT: HBW-Fenster
    activate hbw
    hbw ->> commands : MQTT: HBW-Command\n[sent_count++]
    commands -> sps : OPC UA: HBW aufrufen
    sps -->> commands : angenommen
    hbw ->> ai : MQTT: HBW-Ergebnis\n[nur Report/Diagnose]
    deactivate hbw
  end

  ai -> ai : Ergebnisse für Report zusammenführen\n[keine Command-Barriere]
  deactivate ai

  activate sps
  sps -> sps : Funktionsblöcke nebenläufig ausführen
  par unabhängige VGR-/HBW-Abschlüsse
    sps ->> semaphore : OPC UA: VGR/HBW-Abschluss\n[accepted_count++]
  else unabhängige MPO-/SLD-Abschlüsse
    sps ->> semaphore : OPC UA: MPO/SLD-Abschluss\n[accepted_count++]
  end
  deactivate sps

  semaphore -> semaphore : sent_count == accepted_count\n[für alle vier Module]
  deactivate commands
  deactivate semaphore
end

legend bottom
  |= Pfeil |= Bedeutung |
  | ->> | asynchrone Nachricht |
  | -> | synchroner Aufruf |
  | -->> | Rückgabe |
endlegend

@enduml
